@page "/detailpatterns/{id:int}"
@rendermode InteractiveServer

@if (pattern is null)
{
    <MudText Typo="Typo.body1">Pattern not found.</MudText>
}
else
{
    <MudCard Class="detail-card mb-4">
        <div class="detail-hero-wrap">
            @if (heroImages.Count > 1)
            {
                <MudCarousel Class="detail-carousel" TData="object" ShowArrows="true" ShowBullets="true" EnableSwipeGesture="true" AutoCycle="false">
                    @foreach (var image in heroImages)
                    {
                        <MudCarouselItem Transition="Transition.Slide">
                            <div class="detail-carousel-image" style="background-image: url('@image');"></div>
                        </MudCarouselItem>
                    }
                </MudCarousel>
            }
            else
            {
                @if (heroImages.Count == 1)
                {
                    <div class="detail-hero-placeholder" style="background-image: url('@heroImages[0]'); background-size: cover; background-position: center;"></div>
                }
                else
                {
                    <div class="detail-hero-placeholder">
                        <MudText>No picture</MudText>
                    </div>
                }
            }
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           Class="detail-back-button"
                           OnClick="GoBack" />
        </div>

        <MudCardContent Class="pa-4">
            <div class="d-flex justify-space-between align-center mb-2">
                <MudChip T="string" Size="Size.Small" Color="Color.Tertiary">@pattern.CraftType</MudChip>
                <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">
                    @pattern.PatternType
                </MudText>
            </div>

            <MudText Typo="Typo.h4" Class="mb-1">@pattern.Name</MudText>
            <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);" Class="mb-3">
                Created @pattern.CreatedOn.ToLocalTime().ToString("MMMM d, yyyy")
            </MudText>

            @if (toastMessage is not null)
            {
                <MudAlert Severity="Severity.Success" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="CloseToast">
                    @toastMessage
                </MudAlert>
            }

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.ShoppingCart"
                       Class="pattern-add-button mb-4"
                       OnClick="AddToCart">
                Add to cart
            </MudButton>

            <MudDivider Class="mb-3" />

            <MudText Typo="Typo.h6" Class="mb-2">Materials</MudText>
            @foreach (var material in pattern.Materials)
            {
                <div class="d-flex justify-space-between align-center py-1">
                    <MudText Typo="Typo.body2">
                        @material.MaterialName
                        @if (!string.IsNullOrEmpty(material.ColorOfYarn))
                        {
                            @: — @material.ColorOfYarn
                        }
                    </MudText>
                    <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">
                        @material.Quantity @material.Unit
                    </MudText>
                </div>
            }

            @if (pattern.Equipment.Any())
            {
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.h6" Class="mb-2">Equipment</MudText>
                @foreach (var equipment in pattern.Equipment)
                {
                    <MudText Typo="Typo.body2" Class="py-1">
                        @equipment.EquipmentType
                        @if (equipment.Size.HasValue)
                        {
                            @: — @equipment.Size.Value mm
                        }
                        @if (equipment.Length.HasValue)
                        {
                            @:, @equipment.Length.Value cm
                        }
                    </MudText>
                }
            }

            @if (!string.IsNullOrEmpty(pattern.Description))
            {
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.h6" Class="mb-2">Description</MudText>
                <MudText Typo="Typo.body2">@pattern.Description</MudText>
            }

            @if (!string.IsNullOrEmpty(pattern.Instructions))
            {
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.h6" Class="mb-2">Instructions</MudText>
                <MudText Typo="Typo.body2" Style="white-space: pre-line;">@pattern.Instructions</MudText>
            }

            @if (!string.IsNullOrEmpty(pattern.InstructionsPdf))
            {
                <MudDivider Class="my-3" />
                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.PictureAsPdf"
                           Href="@pattern.InstructionsPdf"
                           Target="_blank">
                    Download instructions (PDF)
                </MudButton>
            }
        </MudCardContent>
    </MudCard>
}
