@page "/patterns"
@rendermode InteractiveServer

<h1>Patterns</h1>
<p>This is where your saved patterns will be listed</p>

@if (toastMessage != null)
{
    <div class="toast">
        @toastMessage
        <button @onclick="GoToCart">View cart</button>
        <button @onclick="CloseToast">×</button>
    </div>
}

<div class="pattern-cards">
     @foreach (var pattern in patterns)
     {
         <div class="pattern-card">
             <h3>@pattern.Name</h3>
             <span>(Created: @pattern.CreatedOn.ToLocalTime().ToString("dd.MM.yyyy"))</span>
             <div class="pattern-card-actions">
                 <button @onclick="() => GoToEdit(pattern.Id)">Edit</button>
                 <button @onclick="() => HandleDelete(pattern.Id)">Delete</button>
                 <button @onclick="() => HandleAddToCart(pattern.Id)">Add to cart</button>
             </div>
         </div>
    }
</div>