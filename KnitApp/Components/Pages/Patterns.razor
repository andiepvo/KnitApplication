@page "/patterns"
@rendermode InteractiveServer

<MudText Typo="Typo.h4" Class="mb-2">Patterns</MudText>

@if (toastMessage != null)
{
    <MudAlert Severity="Severity.Success" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="CloseToast">
        @toastMessage
        <MudButton Variant="Variant.Text" OnClick="GoToCart">View cart</MudButton>
    </MudAlert>
}

<MudGrid Spacing="4">
    @foreach (var pattern in patterns)
    {
        <MudItem xs="12" sm="6" md="4">
            <MudCard Class="pattern-card">
                <div class="pattern-thumbnail" style="cursor: pointer;" @onclick="() => GoToDetails(pattern.Id)">
                    @if (patternThumbnails.TryGetValue(pattern.Id, out var thumbnail) && !string.IsNullOrEmpty(thumbnail))
                    {
                        <MudCardMedia Image="@thumbnail" Height="280" />
                    }
                    else
                    {
                        <div style="height: 280px; background-color: var(--mud-palette-tertiary); display: flex; align-items: center; justify-content: center;">
                            <MudText>No picture</MudText>
                        </div>
                    }
                </div>

                <MudCardContent Class="pa-4">
                    <div class="d-flex justify-space-between align-center mb-2">
                        <MudChip T="string" Size="Size.Small" Color="Color.Tertiary">@pattern.CraftType</MudChip>
                        <div>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => GoToEdit(pattern.Id)" title="Edit" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => HandleDelete(pattern.Id)" title="Delete" />
                        </div>
                    </div>

                    <MudText Typo="Typo.h5" Class="mb-1">@pattern.Name</MudText>
                    <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">
                        Created @pattern.CreatedOn.ToLocalTime().ToString("MMMM d, yyyy")
                    </MudText>
                </MudCardContent>

                <MudCardActions Class="pa-4 pt-0">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.ShoppingCart"
                               Class="pattern-add-button"
                               OnClick="() => HandleAddToCart(pattern.Id)">
                        Add to cart
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    }
</MudGrid>