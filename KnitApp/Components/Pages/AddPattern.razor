@page "/addpatterns" 
@rendermode InteractiveServer

@using KnitApp.Models
@using KnitApp.Services
@using KnitApp.Components.Shared

@inject IPatternService PatternService
@inject NavigationManager NavigationManager 
@inject IYarnCatalogService YarnCatalogService

<h1>Add patterns</h1>
<p>This is where you can add patterns</p>

<EditForm Model="newPattern" OnValidSubmit="HandleSubmit" FormName="AddPatternForm">
    <label>
        Pattern name
        <InputText @bind-Value="newPattern.Name" />
    </label>

    <div>
        @foreach (var material in newPattern.Materials)
        {
            <div @key="material" class="material-row">
                <label>
                    Yarn name
                    <YarnNameAutocomplete @bind-Value="material.MaterialName" Suggestions="yarnCatalog" />
                </label>

                <label>
                    Quantity
                    <button type="button" @onclick="() => DecreaseQuantity(material)">−</button>
                    <InputNumber @bind-Value="material.Quantity" />
                    <button type="button" @onclick="() => IncreaseQuantity(material)">+</button>
                </label>

                <label>
                    Unit
                    <InputSelect @bind-Value="material.Unit">
                        <option value="">Select unit</option>
                        <option value="Skeins">Skeins</option>
                        <option value="Grams">Grams</option>
                        <option value="Meters">Meters</option>
                        <option value="Yards">Yards</option>
                        <option value="Balls">Balls</option>
                    </InputSelect>
                </label>

                <label>
                    Color (optional)
                    <InputText @bind-Value="material.ColorOfYarn" />
                </label>

                @if (newPattern.Materials.Count > 1)
                {
                    <button type="button" @onclick="() => RemoveMaterial(material)">Remove</button>
                }
                
            </div>
        }
    </div>
    
    <button type="button" @onclick="() => AddMaterial()">Add yarn</button>
    
    <label>Craft type</label>
    <InputSelect @bind-Value="newPattern.CraftType">
        @foreach (var type in Enum.GetValues<CraftType>())
        {
            <option value="@type">@type</option>
        }
    </InputSelect>
                
    <label>Pattern type</label>
    <InputSelect @bind-Value="newPattern.PatternType">
        @foreach (var type in Enum.GetValues<PatternType>())
        {
            <option value="@type">@type</option>
        }
    </InputSelect>
                
    <label>
        Description
        <InputTextArea @bind-Value="newPattern.Description" rows="3" style="width: 100%;" />
    </label>

    <label>
        Instructions
        <InputTextArea @bind-Value="newPattern.Instructions" rows="10" style="width: 100%; resize: both;" />
    </label>

    <div class="form-actions">
        <button type="submit">Save</button>
    </div>
</EditForm>

@code {
    [SupplyParameterFromForm]
    private Pattern newPattern { get; set; } = new()
    {
        Materials = new() { new Material() }
    };

    protected async Task HandleSubmit()
    {
        // Ignorer tomme rader brukeren ikke fylte ut
        newPattern.Materials = newPattern.Materials
            .Where(m => !string.IsNullOrWhiteSpace(m.MaterialName))
            .ToList();

        await PatternService.AddAsync(newPattern);
        NavigationManager.NavigateTo("/patterns");
        //to navigate user to another page in the code
    }
    
    protected override async Task OnInitializedAsync()
    {
        yarnCatalog = await YarnCatalogService.GetAllAsync();
    }

    private void RemoveMaterial(Material material)
    {
        newPattern.Materials.Remove(material);
        if (newPattern.Materials.Count == 0)
        {
            newPattern.Materials.Add(new Material());
        }
    }

    private void AddMaterial()
    {
        newPattern.Materials.Add(new Material());
    }

    private void IncreaseQuantity(Material material)
    {
        material.Quantity += 1;
    }

    private void DecreaseQuantity(Material material)
    {
        if (material.Quantity > 0)
            material.Quantity -= 1;
    }
    
    private List<YarnCatalog> yarnCatalog = new();
    
    
}
