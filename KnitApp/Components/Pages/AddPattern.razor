@page "/addpatterns"
@rendermode InteractiveServer

@using KnitApp.Models
@using KnitApp.Components.Shared

<h1>Add patterns</h1>
<p>This is where you can add patterns</p>

<EditForm Model="newPattern" OnValidSubmit="HandleSubmit" FormName="AddPatternForm">
    <label>
        Pattern name
        <InputText @bind-Value="newPattern.Name" />
    </label>

    <div>
        @foreach (var material in newPattern.Materials)
        {
            <div @key="material" class="material-row">
                <label>
                    Yarn name
                    <YarnNameAutocomplete @bind-Value="material.MaterialName" Suggestions="yarnCatalog" />
                </label>

                <label>
                    Quantity
                    <button type="button" @onclick="() => DecreaseQuantity(material)">−</button>
                    <InputNumber @bind-Value="material.Quantity" />
                    <button type="button" @onclick="() => IncreaseQuantity(material)">+</button>
                </label>

                <label>
                    Unit
                    <InputSelect @bind-Value="material.Unit">
                        <option value="">Select unit</option>
                        <option value="Skeins">Skeins</option>
                        <option value="Grams">Grams</option>
                        <option value="Meters">Meters</option>
                        <option value="Yards">Yards</option>
                        <option value="Balls">Balls</option>
                    </InputSelect>
                </label>

                <label>
                    Color (optional)
                    <InputText @bind-Value="material.ColorOfYarn" />
                </label>

                @if (newPattern.Materials.Count > 1)
                {
                    <button type="button" @onclick="() => RemoveMaterial(material)">Remove</button>
                }

            </div>
        }
        @foreach (var equipment in newPattern.Equipment)
        {
            <div @key="equipment" class="equipment-row">
                <label>
                    Equipment
                    <InputText @bind-Value="equipment.EquipmentType" />
                </label>

                <label>
                    Size (mm)
                    <InputNumber @bind-Value="equipment.Size" />
                </label>
                <label>
                    Length (cm)
                    <InputNumber @bind-Value="equipment.Length" />
                </label>
                @if (newPattern.Equipment.Count > 1)
                {
                    <button type="button" @onclick="() => RemoveEquipment(equipment)">Remove</button>
                }

            </div>
        }
        <button type="button" @onclick="() => AddEquipment()">Add equipment</button>
    </div>

    <button type="button" @onclick="() => AddMaterial()">Add yarn</button>

    <label>Craft type</label>
    <InputSelect @bind-Value="newPattern.CraftType">
        @foreach (var type in Enum.GetValues<CraftType>())
        {
            <option value="@type">@type</option>
        }
    </InputSelect>

    <label>Pattern type</label>
    <InputSelect @bind-Value="newPattern.PatternType">
        @foreach (var type in Enum.GetValues<PatternType>())
        {
            <option value="@type">@type</option>
        }
    </InputSelect>

    <label>
        Description
        <InputTextArea @bind-Value="newPattern.Description" rows="3" style="width: 100%;" />
    </label>

    <label>
        Instructions
        <InputTextArea @bind-Value="newPattern.Instructions" rows="10" style="width: 100%; resize: both;" />
    </label>

    <label>
        Instructions PDF (optional)
        <InputFile OnChange="HandlePdfUpload" accept=".pdf,application/pdf" />
    </label>

    <InputText @bind-Value="newPattern.InstructionsPdf" type="hidden" />

    <div class="form-actions">
        <button type="submit" disabled="@isUploadingPdf">Save</button>
    </div>

</EditForm>