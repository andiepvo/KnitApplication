@page "/editpatterns/{id:int}"
@rendermode InteractiveServer

@using KnitApp.Models
@using KnitApp.Components.Shared

<MudText Typo="Typo.h4" Class="mb-4">Edit pattern</MudText>

<div class="pattern-form">
    <EditForm Model="editingPattern" OnValidSubmit="HandleSubmit" FormName="EditPatternForm">
        <DataAnnotationsValidator />

        <MudText Typo="Typo.h6" Class="mb-2">Photos</MudText>
        <InputFile OnChange="HandleImageUpload" multiple accept="image/*" capture="environment" />

        <div class="photo-thumbnails mb-4">
            @foreach (var image in patternImages)
            {
                <div class="photo-item">
                    <img src="@image.FilePath" alt="Pattern photo" class="thumbnail" />
                    <MudButton Variant="Variant.Text"
                               Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.Delete"
                               Size="Size.Small"
                               OnClick="() => RemoveImage(image)">
                        Remove
                    </MudButton>
                </div>
            }
        </div>

        <MudText Typo="Typo.h6" Class="mb-2">Pattern name *</MudText>
        <MudTextField @bind-Value="editingPattern.Name"
                      For="@(() => editingPattern.Name)"
                      Required="true"
                      Variant="Variant.Outlined"
                      Class="form-input mb-4" />

        <MudText Typo="Typo.h6" Class="mb-2">Craft type</MudText>
        <MudSelect T="CraftType" @bind-Value="editingPattern.CraftType"
                   Variant="Variant.Outlined"
                   Class="form-input mb-4">
            @foreach (var type in Enum.GetValues<CraftType>())
            {
                <MudSelectItem T="CraftType" Value="@type">@type</MudSelectItem>
            }
        </MudSelect>

        <MudText Typo="Typo.h6" Class="mb-2">Pattern type</MudText>
        <MudSelect T="PatternType" @bind-Value="editingPattern.PatternType"
                   Variant="Variant.Outlined"
                   Class="form-input">
            @foreach (var type in Enum.GetValues<PatternType>())
            {
                <MudSelectItem T="PatternType" Value="@type">@type</MudSelectItem>
            }
        </MudSelect>

        <MudText Typo="Typo.h6" Class="mb-3 mt-4">Materials</MudText>

        @foreach (var material in editingPattern.Materials)
        {
            <MudCard @key="material" Class="form-section-card mb-3">
                <MudCardContent Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-2">Yarn name</MudText>
                    <YarnNameAutocomplete @bind-Value="material.MaterialName" Suggestions="yarnCatalog" />

                    <MudText Typo="Typo.h6" Class="mb-2 mt-4">Quantity</MudText>
                    <div class="cart-stepper">
                        <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" OnClick="() => ChangeQuantity(material, -1)" />
                        <MudText Class="mx-3"><b>@material.Quantity</b></MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="() => ChangeQuantity(material, 1)" />
                    </div>

                    <MudText Typo="Typo.h6" Class="mb-2 mt-4">Unit</MudText>
                    <MudSelect T="string" @bind-Value="material.Unit"
                               Variant="Variant.Outlined"
                               FullWidth="true"
                               Class="form-input">
                        @foreach (var unit in UnitOptions)
                        {
                            <MudSelectItem T="string" Value="@unit">@unit</MudSelectItem>
                        }
                    </MudSelect>

                    <MudText Typo="Typo.h6" Class="mb-2 mt-4">Color</MudText>
                    <MudTextField @bind-Value="material.ColorOfYarn"
                                  HelperText="Optional — e.g. Heather, Oat"
                                  Variant="Variant.Outlined"
                                  Class="form-input" />

                    @if (editingPattern.Materials.Count > 1)
                    {
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small"
                                   Class="mt-4"
                                   OnClick="() => RemoveMaterial(material)">
                            Remove yarn
                        </MudButton>
                    }
                </MudCardContent>
            </MudCard>
        }

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AddMaterial">
            Add yarn
        </MudButton>

        <MudDivider Class="my-6" />

        <FormSection Title="Equipment">
            @foreach (var equipment in editingPattern.Equipment)
            {
                <MudCard @key="equipment" Class="form-section-card mb-3">
                    <MudCardContent Class="pa-4">
                        <MudText Typo="Typo.h6" Class="mb-2">Equipment type</MudText>
                        <MudTextField @bind-Value="equipment.EquipmentType"
                                      HelperText="e.g. Circular needle, Crochet hook"
                                      Variant="Variant.Outlined"
                                      Class="form-input" />

                        <MudText Typo="Typo.h6" Class="mb-2 mt-4">Size (mm)</MudText>
                        <MudNumericField @bind-Value="equipment.Size"
                                         Variant="Variant.Outlined"
                                         Class="form-input" />

                        <MudText Typo="Typo.h6" Class="mb-2 mt-4">Length (cm)</MudText>
                        <MudNumericField @bind-Value="equipment.Length"
                                         Variant="Variant.Outlined"
                                         Class="form-input" />

                        @if (editingPattern.Equipment.Count > 1)
                        {
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Error"
                                       StartIcon="@Icons.Material.Filled.Delete"
                                       Size="Size.Small"
                                       Class="mt-4"
                                       OnClick="() => RemoveEquipment(equipment)">
                                Remove equipment
                            </MudButton>
                        }
                    </MudCardContent>
                </MudCard>
            }

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddEquipment">
                Add equipment
            </MudButton>
        </FormSection>

        <MudText Typo="Typo.h6" Class="mb-2">Description</MudText>
        <MudTextField @bind-Value="editingPattern.Description"
                      Lines="3"
                      Variant="Variant.Outlined"
                      Class="form-input mb-4" />

        <MudText Typo="Typo.h6" Class="mb-2">Instructions</MudText>
        <MudTextField @bind-Value="editingPattern.Instructions"
                      Lines="15"
                      Variant="Variant.Outlined"
                      Class="form-input resizable-input" />
        <MudDivider Class="my-6" />

        <FormSection Title="Instructions PDF">
            <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);" Class="mb-2">
                Optional — upload a PDF with the full written pattern
            </MudText>

            <InputFile OnChange="HandlePdfUpload" accept=".pdf,application/pdf" />
            <InputText @bind-Value="editingPattern.InstructionsPdf" type="hidden" />

            @if (!string.IsNullOrEmpty(editingPattern.InstructionsPdf))
            {
                <MudLink Href="@editingPattern.InstructionsPdf" Target="_blank" Class="d-block mt-2">View current PDF</MudLink>
            }
        </FormSection>

        @if (errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
        }

        <ValidationSummary />

        <div class="form-actions">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       ButtonType="ButtonType.Submit"
                       Disabled="@(isUploadingPdf || isUploadingImages)"
                       Class="pattern-add-button">
                Save changes
            </MudButton>
        </div>
    </EditForm>
</div>
