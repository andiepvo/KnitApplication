@page "/editpatterns/{id:int}"
@rendermode InteractiveServer

@using KnitApp.Models
@using KnitApp.Components.Shared

<EditForm
    Model="editingPattern"
    OnValidSubmit="HandleSubmit"
    FormName="EditPatternForm">
    <label>
        Pattern name
        <InputText @bind-Value="editingPattern.Name"/>
    </label>

    <label>
        Photos
        <InputFile OnChange="HandleImageUpload" multiple accept="image/*" capture="environment" />
    </label>

    <div class="photo-thumbnails">
        @foreach (var image in patternImages)
        {
            <div class="photo-item">
                <img src="@image.FilePath" alt="Pattern photo" class="thumbnail" />
                <button type="button" @onclick="() => RemoveImage(image)">Remove</button>
            </div>
        }
    </div>

    <div>
        @foreach (var material in editingPattern.Materials)
        {
            <div @key="material" class="material-row">

                <label>
                    Yarn name
                    <YarnNameAutocomplete @bind-Value="material.MaterialName" Suggestions="yarnCatalog" />
                </label>

                <label>
                    Quantity
                    <button type="button" @onclick="() => ChangeQuantity(material, -1)">−</button>
                    <InputNumber @bind-Value="material.Quantity" />
                    <button type="button" @onclick="() => ChangeQuantity(material, 1)">+</button>
                </label>

                <label>
                    Unit
                    <InputSelect @bind-Value="material.Unit">
                        <option value="">Select unit</option>
                        <option value="Skeins">Skeins</option>
                        <option value="Grams">Grams</option>
                        <option value="Meters">Meters</option>
                        <option value="Yards">Yards</option>
                        <option value="Balls">Balls</option>
                    </InputSelect>
                </label>

                <label>
                    Color (optional)
                    <InputText @bind-Value="material.ColorOfYarn" />
                </label>

                @if (editingPattern.Materials.Count > 1)
                {
                    <button type="button" @onclick="() => RemoveMaterial(material)">Remove</button>
                }
            </div>
        }
        @foreach (var equipment in editingPattern.Equipment)
        {
            <div @key="equipment" class="equipment-row">
                <label>
                    Equipment
                    <YarnNameAutocomplete @bind-Value="equipment.EquipmentType" />
                </label>
                <label>
                    Size (mm)
                    <InputNumber @bind-Value="equipment.Size" />
                </label>
                <label>
                    Length (cm)
                    <InputNumber @bind-Value="equipment.Length"/>
                </label>
                @if (editingPattern.Equipment.Count > 1)
                {
                    <button type="button" @onclick="() => RemoveEquipment(equipment)">Remove</button>
                }
            </div>
        }
        <button type="button" @onclick="() => AddEquipment()">Add equipment</button>
    </div>

    <button type="button" @onclick="() => AddMaterial()">Add yarn</button>

    <label>Craft type</label>
    <InputSelect @bind-Value="editingPattern.CraftType">
        @foreach (var type in Enum.GetValues<CraftType>())
        {
            <option value="@type">@type</option>
        }
    </InputSelect>

    <label>Pattern type</label>
    <InputSelect @bind-Value="editingPattern.PatternType">
        @foreach (var type in Enum.GetValues<PatternType>())
        {
            <option value="@type">@type</option>
        }
    </InputSelect>

    <label>
        Description
        <InputTextArea @bind-Value="editingPattern.Description" rows="3" style="width: 100%;" />
    </label>

    <label>
        Instructions
        <InputTextArea @bind-Value="editingPattern.Instructions" rows="10" style="width: 100%; resize: both;" />
    </label>
    <label>
        Instructions PDF (optional)
        <InputFile OnChange="HandlePdfUpload" accept=".pdf,application/pdf" />
    </label>
    <InputText @bind-Value="editingPattern.InstructionsPdf" type="hidden" />

    @if (!string.IsNullOrEmpty(editingPattern.InstructionsPdf))
    {
        <a href="@editingPattern.InstructionsPdf" target="_blank">View current PDF</a>
    }

    <div class="form-actions">
        <button type="submit" disabled="@isUploadingPdf">Save changes</button>
    </div>

</EditForm>

