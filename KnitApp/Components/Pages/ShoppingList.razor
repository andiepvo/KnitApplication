@page "/shopping-list"
@rendermode InteractiveServer

<h1>Shopping list</h1>
<p>This is where you can see the shopping list accordingly to chosen pattern</p>
<ul>
    @foreach (var pattern in patterns)
    {
        <li>
            <input type="checkbox"
                   checked="@selectedPatternIds.Contains(pattern.Id)"
                   @onchange="@((ChangeEventArgs e) => ToggleSelection(pattern.Id, (bool)e.Value!))" />
            @pattern.Name
        </li>
    }
</ul>

<button @onclick="GenerateList">Generate Shopping List</button>

@if (shoppingList.Count > 0)
{
    <h2>Your Shopping List</h2>
    <ul>
        @foreach (var item in shoppingList)
        {
            <li>@item.YarnName - @item.TotalQuantity @item.Unit</li>
        }
    </ul>
}