@using KnitApp.Models

<div>
    <input value="@Value" @oninput="OnInput" />

    @if (showSuggestions && FilteredSuggestions.Any())
    {
        <div>
            @foreach (var suggestion in FilteredSuggestions)
            {
                <div @key="suggestion.Id" @onclick="() => SelectSuggestion(suggestion)">
                    @suggestion.Name (@suggestion.Brand)
                </div>
            }
        </div>
    }
</div>