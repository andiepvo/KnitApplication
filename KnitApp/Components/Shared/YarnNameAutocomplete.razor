@using KnitApp.Models

<div class="yarn-autocomplete">
    <input class="yarn-autocomplete-input" value="@Value" @oninput="OnInput" />

    @if (showSuggestions && FilteredSuggestions.Any())
    {
        <div class="yarn-autocomplete-suggestions">
            @foreach (var suggestion in FilteredSuggestions)
            {
                <div @key="suggestion.Id" class="yarn-autocomplete-suggestion" @onclick="() => SelectSuggestion(suggestion)">
                    @suggestion.Name (@suggestion.Brand)
                </div>
            }
        </div>
    }
</div>